# Example Terraform Variables File
# Copy this to terraform.tfvars and modify as needed

# Docker configuration
docker_host = "unix:///var/run/docker.sock"

# Nginx image configuration
nginx_image   = "nginx"
nginx_version = "latest"
keep_image_locally = true

# Network configuration
network_name = "nginx-network"

# Container configuration
container_name = "nginx-webserver"
restart_policy = "always"

# Port configuration
external_port = 8000

# Resource limits
container_memory      = 536870912  # 512MB
container_memory_swap = -1         # Unlimited
container_cpu_shares  = 1024       # Default

# Logging configuration
log_driver   = "json-file"
log_max_size = "10m"
log_max_file = "3"

# Volume paths
html_path = "/var/www/html"

# Environment variables
timezone    = "UTC"
environment = "production"

# For development environment
# environment = "development"
# container_memory = 268435456  # 256MB
# external_port = 8080

# For staging environment
# environment = "staging"
# nginx_version = "1.25-alpine"
# external_port = 8081
